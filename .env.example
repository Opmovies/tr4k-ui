# Copiez ce fichier en .env et adaptez les valeurs.

# Port exposé sur l'hôte (le conteneur écoute toujours sur 3000 en interne)
PORT=3010

# URL de base de l'API TR4KER
NUXT_TR4KER_BASE=https://tr4ker.net

# OBLIGATOIRE en production : clé de chiffrement des cookies de session.
# Générez-la avec :  openssl rand -hex 32
NUXT_SESSION_SECRET=

# Optionnel — instance multi-comptes : IDs utilisateurs autorisés à gérer les
# plugins, séparés par des virgules (ex: 12,34). Un plugin serveur s'exécute sans
# bac à sable : ne l'ouvrez qu'à des comptes de confiance. Laissez vide en solo.
NUXT_PLUGIN_ADMINS=

# Optionnel — repli mono-compte : utiliser la clé API de ../tr4ker.config.json
# au lieu d'un login. Laissez à 0 pour exiger une connexion.
NUXT_ALLOW_CONFIG_KEY=0

# Optionnel — clé imgbb pour l'upload d'images du chat/commentaires.
NUXT_IMGBB_KEY=
